# SentinelVAPT Backend — Environment Variables Template
# Copy to .env for local development. Never commit .env or secrets to Git.

# ---------------- Server & Deployment ----------------
PORT=8000
CLOUD_MODE=false
STORAGE_BACKEND=local
SECRET_KEY=sentinel-dev-secret-key-change-in-production

# ---------------- CORS / Allowed Frontend Origins ----------------
# Comma-separated allowed origins (e.g. your Vercel deployment URL)
ALLOWED_ORIGINS=http://localhost:5173,https://sentinelvapt.vercel.app

# ---------------- Database Connection ----------------
# Local development default: SQLite
VULNPILOT_DB=./vulnpilot.db

# Production: Neon PostgreSQL connection string (always include ?sslmode=require)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-random-name.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------- Initial Admin Credentials ----------------
# If set, automatically provisions the administrator account on startup
ADMIN_EMAIL=admin@sentinelvapt.local
ADMIN_PASSWORD=Admin123!SentinelVAPT

# ---------------- Optional LLM Integration (OpenAI-compatible) ----------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---------------- Optional ZAP Integration ----------------
ZAP_API_URL=http://127.0.0.1:8090
ZAP_API_KEY=
